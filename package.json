{
  "name": "metanno",
  "version": "2.0.0-beta.2",
  "description": "Data exploration and annotation in JupyterLab and Python",
  "main": "client/index.ts",
  "repository": "https://github.com/percevalw/metanno",
  "author": "Perceval Wajsbürt <perceval.wajsburt@gmail.com>",
  "scripts": {
    "build:react-data-grid": "npm --prefix submodules/react-data-grid run prepublishOnly",
    "build": "jlpm clean && jlpm build:react-data-grid && jlpm build:jupyter",
    "build:dev": "jlpm clean && jlpm build:react-data-grid && jlpm build:jupyter:dev",
    "build:jupyter": "jupyter labextension build .",
    "build:jupyter:dev": "jupyter labextension build --development True .",
    "clean": "rm -rf metanno/js-extension"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "pret": ">=0.7.0-beta.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0"
  },
  "dependencies": {
    "color": "^4.2.3",
    "konva": "^9.3.18",
    "react-autosuggest": "^10.1.0",
    "react-data-grid": "link:./submodules/react-data-grid",
    "react-fast-compare": "^3.2.2",
    "react-konva": "^17.0.1-3",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^3.6.8",
    "@jupyterlab/galata": "5.5.11",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "old-galata": "npm:@jupyterlab/galata@4.5.8",
    "prettier": "^2.8.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "ts-loader": "^9.4.2",
    "typescript": "^5.8.2",
    "@jupyterlab/application": "^3.6.8",
    "@jupyterlab/apputils": "^3.6.8",
    "@jupyterlab/coreutils": "^5.6.8",
    "@jupyterlab/launcher": "^3.6.8",
    "@jupyterlab/mainmenu": "^3.6.8",
    "@jupyterlab/notebook": "^3.6.8",
    "@jupyterlab/rendermime": "^3.6.8",
    "@jupyterlab/rendermime-interfaces": "3.6.8",
    "@jupyterlab/services": "^6.6.8",
    "@jupyterlab/ui-components": "^3.6.8",
    "@lumino/algorithm": "^1.9.2",
    "@lumino/commands": "^1.21.1",
    "@lumino/coreutils": "^1.12.1",
    "@lumino/messaging": "^1.10.3",
    "@lumino/signaling": "^1.11.1",
    "@lumino/widgets": "^1.37.2",
    "@playwright/test": "1.62.1",
    "jsdom": "^20.0.3"
  },
  "resolutions": {
    "webpack": "5.88.2",
    "@jupyterlab/rendermime-interfaces": "3.6.8",
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1"
  },
  "jupyterlab": {
    "extension": "client/plugin.ts",
    "outputDir": "metanno/js-extension",
    "webpackConfig": "./webpack.jupyter.js",
    "sharedPackages": {
      "pret": {
        "bundled": false,
        "singleton": true
      }
    }
  },
  "prettier": {},
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
